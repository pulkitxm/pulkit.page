{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/*": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["@pulkit/theme"]
    },
    "packages/engine": {
      "entry": [
        "src/{build,dev,start,clean,check-layouts,check-seo,check-site,check-browser}.mjs",
        "test/setup.mjs"
      ],
      "project": ["**/*.{mjs,css}"]
    },
    "packages/embeds": {
      "entry": ["client/entries/*.ts"],
      "project": ["src/**/*.ts", "client/**/*.ts"]
    },
    "packages/demos": {
      "entry": ["index.js"],
      "project": ["**/*.{js,mjs,css}"]
    },
    "packages/theme": {
      "entry": ["src/client/theme.ts"],
      "project": ["src/**/*.ts", "*.css"]
    },
    "packages/code": {
      "project": ["src/**/*.ts"]
    },
    "tooling/checks": {
      "entry": ["src/commands/check-*.ts"],
      "project": ["src/**/*.ts"]
    },
    "tooling/lighthouse": {
      "entry": ["src/commands/lighthouse.ts", "src/commands/worker.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.{ts,css}"]
    }
  }
}
