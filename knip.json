{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/*": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["@pulkit/theme"]
    },
    "packages/engine": {
      "entry": [
        "src/{build,dev,start,clean,check-layouts,check-seo,check-site,check-browser}.mjs",
        "test/setup.mjs"
      ],
      "project": ["**/*.{mjs,css}"]
    },
    "packages/embeds": {
      "entry": ["client/*.js"],
      "project": ["src/**/*.mjs", "client/**/*.js"]
    },
    "packages/demos": {
      "entry": ["index.js"],
      "project": ["**/*.{js,mjs,css}"]
    },
    "packages/theme": {
      "entry": ["theme.js"],
      "project": ["*.{js,css}", "src/**/*.mjs"]
    },
    "packages/code": {
      "project": ["src/**/*.mjs"]
    },
    "tooling/checks": {
      "entry": ["src/check-*.mjs"],
      "project": ["src/**/*.mjs"]
    },
    "tooling/lighthouse": {
      "entry": ["src/lighthouse.mjs", "src/worker.mjs"],
      "project": ["src/**/*.mjs"]
    },
    "packages/shared": {
      "project": ["src/**/*.mjs"]
    }
  }
}
