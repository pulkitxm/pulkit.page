{
  "name": "pulkit-page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch scripts/dev.mjs",
    "dev:clean": "bun run clean && bun run dev",
    "build": "bun scripts/build.mjs",
    "start": "bun scripts/start.mjs",
    "serve": "bun run build && bun run start",
    "serve:clean": "bun run clean && bun run serve",
    "clean": "bun scripts/clean.mjs",
    "check:comments": "bun scripts/check-comments.mjs",
    "check:generated": "sh scripts/check-sync.sh",
    "check:repository": "bun scripts/check-repository.mjs",
    "check:site": "bun scripts/check-site.mjs dist",
    "ci": "bun scripts/ci.mjs",
    "format": "biome check --write . && bun scripts/check-content.mjs --write",
    "format:check": "biome format . && bun scripts/check-content.mjs",
    "lint": "biome check --error-on-warnings . && bun scripts/check-content.mjs && html-validate \"pages/**/*.html\"",
    "test": "bun test ./scripts",
    "generate": "sh scripts/generate.sh",
    "hooks:install": "sh scripts/install-hooks.sh",
    "postinstall": "sh scripts/install-hooks.sh",
    "check:shell": "sh -n scripts/generate.sh && sh -n scripts/check-sync.sh && sh -n scripts/install-hooks.sh && sh -n .githooks/pre-commit",
    "check:layouts": "bun scripts/check-layouts.mjs",
    "check:content": "bun scripts/check-content.mjs",
    "check:imports": "bun scripts/check-imports.mjs",
    "check:em-dashes": "bun scripts/check-em-dashes.mjs",
    "check:dead-code": "knip --no-progress --max-issues 0 --treat-config-hints-as-errors",
    "import:reference": "bun scripts/import-reference.mjs",
    "check:seo": "bun scripts/check-seo.mjs",
    "browser:check": "bun scripts/check-browser.mjs",
    "lighthouse": "bun run build && bun scripts/lighthouse.mjs",
    "lighthouse:prod": "bun scripts/lighthouse.mjs --origin https://pulkit.page"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/parser": "8.0.6",
    "@biomejs/biome": "2.5.14",
    "@dimforge/rapier3d-compat": "0.20.0",
    "@fontsource/poppins": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "chrome-launcher": "1.2.1",
    "embla-carousel": "8.6.0",
    "html-validate": "11.16.0",
    "katex": "0.18.7",
    "knip": "6.37.0",
    "lighthouse": "13.5.0",
    "lucide": "1.47.0",
    "marked": "18.0.13",
    "meshline": "3.3.1",
    "motion": "13.4.0",
    "parse5": "8.0.1",
    "photoswipe": "5.4.4",
    "playwright": "1.63.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "tree-sitter-wasm": "2.0.1",
    "unified": "11.0.5",
    "vite": "8.3.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1"
  }
}
