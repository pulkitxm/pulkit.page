{
  "name": "pulkit",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "ci": "turbo run verify",
    "format": "biome check --write . && bun tooling/checks/src/check-content.mjs --write",
    "format:check": "biome format . && bun tooling/checks/src/check-content.mjs",
    "lint": "biome check --error-on-warnings .",
    "check:content": "bun tooling/checks/src/check-content.mjs",
    "check:comments": "bun tooling/checks/src/check-comments.mjs",
    "check:repository": "bun tooling/checks/src/check-repository.mjs",
    "check:em-dashes": "bun tooling/checks/src/check-em-dashes.mjs",
    "check:imports": "bun tooling/checks/src/check-imports.mjs",
    "check:dead-code": "knip --no-progress --max-issues 0 --treat-config-hints-as-errors",
    "check:shell": "sh -n tooling/checks/install-hooks.sh && sh -n .githooks/pre-commit",
    "postinstall": "sh tooling/checks/install-hooks.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "knip": "6.37.0",
    "turbo": "2.11.2"
  }
}
