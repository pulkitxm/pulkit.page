{
  "name": "pulkit",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "overrides": {
    "@parcel/watcher": "2.6.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:clean": "turbo run clean && turbo run dev",
    "build": "turbo run build",
    "build:clean": "turbo run clean && turbo run build --force",
    "serve": "turbo run start",
    "serve:clean": "turbo run clean && turbo run start --force",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "lighthouse": "turbo run build --filter=\"./apps/*\" && bun tooling/lighthouse/src/commands/lighthouse.ts",
    "lighthouse:prod": "bun tooling/lighthouse/src/commands/lighthouse.ts --prod",
    "ci": "turbo run verify",
    "format": "biome check --write . && bun tooling/checks/src/commands/check-content.ts --write",
    "format:check": "biome format . && bun tooling/checks/src/commands/check-content.ts",
    "lint": "biome check --error-on-warnings .",
    "check:content": "bun tooling/checks/src/commands/check-content.ts",
    "media:optimize": "bun tooling/checks/src/commands/optimize-media.ts",
    "media:fix": "bun tooling/checks/src/commands/fix-media.ts",
    "check:comments": "bun tooling/checks/src/commands/check-comments.ts",
    "check:repository": "bun tooling/checks/src/commands/check-repository.ts",
    "check:media": "bun tooling/checks/src/commands/check-media.ts",
    "check:em-dashes": "bun tooling/checks/src/commands/check-em-dashes.ts",
    "check:imports": "bun tooling/checks/src/commands/check-imports.ts",
    "check:gallery": "bun tooling/checks/src/commands/check-reviewed-gallery.ts",
    "gallery:sync": "bun tooling/checks/src/commands/sync-reviewed-gallery.ts",
    "check:types": "tsc -p tsconfig.json",
    "check:dead-code": "knip --no-progress --max-issues 0 --treat-config-hints-as-errors",
    "check:shell": "sh -n tooling/checks/install-hooks.sh && sh -n tooling/checks/install-media-tools.sh && sh -n tooling/checks/publish-blog.sh && sh -n .githooks/pre-commit",
    "postinstall": "sh tooling/checks/install-hooks.sh",
    "gallery:record": "bun packages/engine/src/captures/capture-projects.ts",
    "gallery:finalize": "bun packages/engine/src/captures/finalize-project-captures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "knip": "6.37.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  }
}
