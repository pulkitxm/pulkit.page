{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.githooks/**",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/knip.json",
        "$TURBO_ROOT$/*/*/package.json",
        "$TURBO_ROOT$/*/*/turbo.json"
