{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "biome.json", ".htmlvalidate.json", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "POSTHOG_DEBUG",
    "POSTHOG_HOST",
    "POSTHOG_IGNORE_KEY",
    "POSTHOG_KEY",
    "SITE_URL"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!.cache/**"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "check:layouts": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "check:seo": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:site": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:html": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:browser": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["BROWSER_SHARD", "BROWSER_VIEWPORT", "PLAYWRIGHT_CHANNEL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#check:content": {
      "outputs": []
    },
    "//#check:comments": {
      "outputs": []
    },
    "//#check:repository": {
      "outputs": []
    },
    "//#check:em-dashes": {
      "outputs": []
    },
    "//#check:imports": {
      "outputs": []
    },
    "//#check:types": {
      "outputs": []
    },
    "//#check:dead-code": {
      "outputs": []
    },
    "//#check:shell": {
      "outputs": []
    },
    "verify": {
      "dependsOn": [
        "test",
        "check:layouts",
        "check:seo",
        "check:site",
        "check:html",
        "//#format:check",
        "//#lint",
        "//#check:content",
        "//#check:comments",
        "//#check:repository",
        "//#check:em-dashes",
        "//#check:imports",
        "//#check:types",
        "//#check:dead-code",
        "//#check:shell"
      ],
      "outputs": []
    }
  }
}
